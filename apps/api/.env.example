APP_NAME=Meridian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

# Versioned API and the SPA that consumes it
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173
# Origins allowed to call the API with credentials (comma-separated); defaults to FRONTEND_URL
# CORS_ALLOWED_ORIGINS=https://app.meridian.app
API_DOCS_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=

# Stateless API: no server-side sessions
SESSION_DRIVER=array

# Redis in deployed environments (docs/08); database works for local development
CACHE_STORE=database
QUEUE_CONNECTION=database

HASH_DRIVER=argon2id

# JWT access tokens — generate a secret with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(64)).PHP_EOL;"
JWT_SECRET=
JWT_KEY_ID=v1
JWT_AUDIENCE=meridian-api
JWT_ACCESS_TOKEN_TTL=900

# Refresh tokens (HttpOnly cookie). Set SECURE=false only for plain-HTTP local development.
REFRESH_TOKEN_TTL=1209600
REFRESH_TOKEN_COOKIE_SECURE=false

PASSWORD_CHECK_COMPROMISED=true

# Brute-force limits per minute (defaults 5 / 20). Raise only for automated E2E environments.
# AUTH_RATE_LIMIT_LOGIN_PER_ACCOUNT=5
# AUTH_RATE_LIMIT_LOGIN_PER_IP=20

# Employees: photos go to a private disk (use an S3 disk in deployed environments)
EMPLOYEE_NUMBER_PREFIX=EMP-
EMPLOYEE_PHOTO_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@meridian.test"
MAIL_FROM_NAME="${APP_NAME}"
