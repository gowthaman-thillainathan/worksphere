<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>src/Modules/*/Tests/Unit</directory>
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>src/Modules/*/Tests/Feature</directory>
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Modules/*/Tests</directory>
            <directory>src/Modules/*/Database</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10="/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="API_DOCS_ENABLED" value="true"/>
        <env name="FRONTEND_URL" value="https://app.meridian.test"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="meridian_test"/>
        <env name="DB_USERNAME" value="meridian"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="SESSION_DRIVER" value="array"/>
