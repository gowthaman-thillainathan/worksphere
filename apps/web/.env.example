# Where the dev/preview server proxies /api (the Laravel API).
API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL the built SPA calls. Keep "/api/v1" when the SPA is served behind
# the same origin as the API (or through the proxy); set the full API URL,
# e.g. https://api.meridian.app/api/v1, for a separate API origin.
VITE_API_BASE_URL=/api/v1
